---
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import mindcover from "@assets/images/profile/mindcover.webp";
import ChapterCard from "@components/ui/ChapterCard.astro";
import type { Chapter } from "@/types";

const chapters: Chapter[] = [
  {
    title: "Introducción",
    subtitle: "El inicio",
    blocked: true,
    image: "profile/introduction.webp",
  },
  {
    title: "Paraíso",
    subtitle: "2019",
    blocked: true,
    image: "profile/idkwhoishim.webp",
  },
  {
    title: "Preguntas",
    subtitle: "2020",
    blocked: true,
    image: "profile/questions.webp",
  },
  {
    title: "El Inicio del Fin",
    subtitle: "2021",
    blocked: true,
    image: "profile/unknowman.webp",
  },
  {
    title: "Pozo",
    subtitle: "2022",
    blocked: true,
    image: "profile/unknowman.webp",
  },
  {
    title: "Cambios",
    subtitle: "2023",
    blocked: true,
    image: "profile/unknowman.webp",
  },
  {
    title: "Amigos",
    subtitle: "2024",
    blocked: true,
    image: "profile/unknowman.webp",
  },
  {
    title: "Estrés",
    subtitle: "2025",
    blocked: true,
    image: "profile/unknowman.webp",
  },
  {
    title: "Futuro",
    subtitle: "2026",
    blocked: true,
    image: "profile/unknowman.webp",
  },
];
---

<Layout title="Snowy | Mente">
  <!-- Banner -->
  <section>
    <Image
      src={mindcover}
      alt="mindcover"
      loading="eager"
      fetchpriority="high"
      class="w-full h-auto rounded-xl object-cover shadow-sm border border-neutral-300 dark:border-neutral-700/60"
    />
  </section>

  <!-- titulo, galeria y capitulos -->
  <nav
    class="flex justify-between items-end mt-10 border-b border-neutral-300 dark:border-neutral-700 pb-2"
  >
    <div class="flex justify-start">
      <h1
        class="text-3xl md:text-5xl font-bold tracking-tighter text-neutral-900 dark:text-white"
      >
        Capítulos
      </h1>
    </div>

    <div class="flex justify-end">
      <a
        href="#"
        class="group relative inline-flex items-center gap-2.5 px-5 py-2.5 rounded-xl border border-neutral-300 dark:border-neutral-700 bg-white/60 dark:bg-neutral-900/60 backdrop-blur-xs hover:border-red-600 dark:hover:border-red-500 hover:bg-neutral-900 dark:hover:bg-neutral-100 hover:text-white dark:hover:text-neutral-900 text-neutral-800 dark:text-neutral-200 transition-all duration-300 shadow-sm cursor-pointer"
        title="Galería fotográfica completa (Próximamente)"
      >
        <!-- Icono de cámara / visor -->
        <svg
          class="w-4 h-4 text-neutral-500 group-hover:text-red-500 dark:group-hover:text-red-600 transition-colors"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"
          />
        </svg>

        <span class="font-mono text-xs uppercase tracking-widest font-bold">
          Galería
        </span>

        <span
          class="font-mono text-[9px] px-1.5 py-0.5 rounded border border-neutral-300 dark:border-neutral-700 text-neutral-400 group-hover:border-red-500/50 group-hover:text-red-400 uppercase tracking-tight"
        >
          ARCHIVO
        </span>
      </a>
    </div>
  </nav>

  <section class="mt-8">
    <div
      class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto"
    >
      {chapters.map((chapter) => (
        <ChapterCard {...chapter} />
      ))}
    </div>
  </section>
</Layout>
