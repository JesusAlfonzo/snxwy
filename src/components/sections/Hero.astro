---
import { Image } from "astro:assets";
import unknownMan from "@assets/images/profile/unknowman.webp";
import importantPeople from "@assets/images/profile/importantpeople.webp";
---

<section
  aria-label="Ficha de Identificación de Snowy"
  class="mt-6 mb-16 w-full"
>
  <!-- MARCO PRINCIPAL: DOSSIER MILITAR / TÉCNICO -->
  <div
    class="relative rounded-2xl border border-neutral-300/80 dark:border-neutral-800/80 bg-white/50 dark:bg-[#141519]/70 backdrop-blur-xs p-6 sm:p-8 md:p-10 shadow-sm overflow-hidden"
  >
    <!-- Marcas de esquina de calibración táctica -->
    <div
      class="absolute top-2.5 left-3 text-[9px] font-mono text-neutral-400 dark:text-neutral-600 select-none tracking-widest"
    >
      [+] CALIB_OK
    </div>
    <div
      class="absolute top-2.5 right-3 text-[9px] font-mono text-neutral-400 dark:text-neutral-600 select-none tracking-widest hidden sm:block"
    >
      SEC_DOC // MIL-SPEC-2026
    </div>

    <!-- Barra Superior del Expediente -->
    <div
      class="flex flex-wrap items-center justify-between gap-3 border-b border-neutral-200/90 dark:border-neutral-800/80 pb-4 mb-8 font-mono text-[10px] sm:text-[11px]"
    >
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span
          class="font-bold tracking-wider text-neutral-800 dark:text-neutral-200 uppercase"
        >
          EXPEDIENTE DE IDENTIDAD
        </span>
        <span class="text-neutral-400 dark:text-neutral-600">// REF: SNXWY-01</span>
      </div>

      <div class="flex items-center gap-3">
        <span
          class="px-2.5 py-0.5 rounded border border-red-500/30 bg-red-500/10 text-red-600 dark:text-red-400 font-bold uppercase tracking-widest text-[9px]"
        >
          DESCLASIFICADO
        </span>
        <span
          class="text-neutral-400 dark:text-neutral-500 tracking-wider hidden sm:inline"
        >
          TEATRO: CARACAS
        </span>
      </div>
    </div>

    <!-- CUERPO DEL DOSSIER: FOTO TÁCTICA + ESPECIFICACIONES -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">
      <!-- COLUMNA IZQUIERDA: FOTO TÁCTICA CON VISOR MILITAR -->
      <div class="md:col-span-5 flex flex-col items-center">
        <div
          class="relative group w-56 h-56 sm:w-64 sm:h-64 p-2.5 rounded-xl border border-neutral-300 dark:border-neutral-700/80 bg-neutral-100/80 dark:bg-neutral-800/40 shadow-inner"
        >
          <!-- Brackets de visor militar en las esquinas -->
          <span
            class="absolute top-0 left-0 w-3.5 h-3.5 border-t-2 border-l-2 border-neutral-500 dark:border-neutral-400"
          ></span>
          <span
            class="absolute top-0 right-0 w-3.5 h-3.5 border-t-2 border-r-2 border-neutral-500 dark:border-neutral-400"
          ></span>
          <span
            class="absolute bottom-0 left-0 w-3.5 h-3.5 border-b-2 border-l-2 border-neutral-500 dark:border-neutral-400"
          ></span>
          <span
            class="absolute bottom-0 right-0 w-3.5 h-3.5 border-b-2 border-r-2 border-neutral-500 dark:border-neutral-400"
          ></span>

          <!-- Contenedor de fotografías con transición hover (misterio -> amigos) -->
          <div class="relative w-full h-full rounded-lg overflow-hidden shadow-md">
            <Image
              src={unknownMan}
              alt="Snowy - Fotografía de identificación militar"
              width={600}
              height={600}
              loading="eager"
              fetchpriority="high"
              class="absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 opacity-100 group-hover:opacity-0 transition-all duration-700"
            />

            <Image
              src={importantPeople}
              alt="Snowy y su círculo cercano"
              width={600}
              height={600}
              loading="lazy"
              class="absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 scale-95 group-hover:scale-100 transition-all duration-700"
            />

            <!-- Scanline táctico sutil -->
            <div
              class="absolute inset-0 pointer-events-none bg-[linear-gradient(rgba(18,19,22,0)_50%,rgba(0,0,0,0.18)_50%)] bg-[length:100%_4px] opacity-20"
            >
            </div>
          </div>

          <!-- Tag de figura militar en la parte inferior -->
          <div
            class="absolute -bottom-3 left-1/2 -translate-x-1/2 px-2.5 py-0.5 bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 font-mono text-[9px] uppercase tracking-widest rounded-full shadow-sm select-none"
          >
            FIG. 01 — REGISTRO
          </div>
        </div>

        <!-- Código de barras militar y serie -->
        <div
          class="mt-6 flex flex-col items-center gap-1 font-mono text-neutral-400 dark:text-neutral-500 select-none"
        >
          <div class="flex items-center gap-[2px] h-3.5 opacity-65">
            <span class="w-[2px] h-full bg-current"></span>
            <span class="w-[1px] h-full bg-current"></span>
            <span class="w-[3px] h-full bg-current"></span>
            <span class="w-[1px] h-full bg-current"></span>
            <span class="w-[2px] h-full bg-current"></span>
            <span class="w-[1px] h-full bg-current"></span>
            <span class="w-[4px] h-full bg-current"></span>
            <span class="w-[2px] h-full bg-current"></span>
            <span class="w-[1px] h-full bg-current"></span>
            <span class="w-[3px] h-full bg-current"></span>
            <span class="w-[1px] h-full bg-current"></span>
            <span class="w-[2px] h-full bg-current"></span>
            <span class="w-[4px] h-full bg-current"></span>
            <span class="w-[1px] h-full bg-current"></span>
            <span class="w-[2px] h-full bg-current"></span>
          </div>
          <span class="text-[9px] tracking-[0.25em]">SNXWY-0249 // CCS-VE</span>
        </div>
      </div>

      <!-- COLUMNA DERECHA: ESPECIFICACIONES Y COMMS -->
      <div class="md:col-span-7 flex flex-col text-left">
        <!-- Título principal y distintivo de llamada -->
        <div class="border-b border-neutral-200/90 dark:border-neutral-800/80 pb-4 mb-6">
          <div class="flex items-center gap-3">
            <h1
              class="text-4xl sm:text-6xl font-black text-neutral-900 dark:text-white tracking-tighter"
            >
              SNOWY
            </h1>
            <span
              class="text-[10px] font-mono px-2 py-0.5 rounded border border-neutral-300 dark:border-neutral-700 bg-neutral-200/60 dark:bg-neutral-800/60 text-neutral-700 dark:text-neutral-300 font-semibold tracking-wider"
            >
              OP-01
            </span>
          </div>
          <p
            class="text-sm sm:text-base font-medium text-neutral-500 dark:text-neutral-400 italic mt-1 leading-snug"
          >
            "Tu figura religiosa disruptiva favorita"
          </p>
        </div>

        <!-- Matriz de Datos Tácticos (Grid 2x2) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6 font-mono">
          <div
            class="p-3 rounded-lg border border-neutral-200/80 dark:border-neutral-800 bg-neutral-100/60 dark:bg-neutral-800/30"
          >
            <span
              class="text-[9px] uppercase tracking-wider text-neutral-400 dark:text-neutral-500 block mb-0.5 font-bold"
            >
              // IDENTIDAD
            </span>
            <span
              class="text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 font-bold tracking-tight"
            >
              Clasificado (u know me)
            </span>
          </div>

          <div
            class="p-3 rounded-lg border border-neutral-200/80 dark:border-neutral-800 bg-neutral-100/60 dark:bg-neutral-800/30"
          >
            <span
              class="text-[9px] uppercase tracking-wider text-neutral-400 dark:text-neutral-500 block mb-0.5 font-bold"
            >
              // ESTADO OPERACIONAL
            </span>
            <span
              class="text-xs sm:text-sm text-emerald-600 dark:text-emerald-400 font-bold flex items-center gap-1.5"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"
              ></span>
              VIVO // ACTIVO
            </span>
          </div>

          <div
            class="p-3 rounded-lg border border-neutral-200/80 dark:border-neutral-800 bg-neutral-100/60 dark:bg-neutral-800/30"
          >
            <span
              class="text-[9px] uppercase tracking-wider text-neutral-400 dark:text-neutral-500 block mb-0.5 font-bold"
            >
              // COORDENADAS
            </span>
            <span
              class="text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 font-bold"
            >
              Caracas, VZLA
            </span>
            <span
              class="text-[10px] text-neutral-400 dark:text-neutral-500 block font-normal"
            >
              10°29' N · 66°53' W
            </span>
          </div>

          <div
            class="p-3 rounded-lg border border-neutral-200/80 dark:border-neutral-800 bg-neutral-100/60 dark:bg-neutral-800/30"
          >
            <span
              class="text-[9px] uppercase tracking-wider text-neutral-400 dark:text-neutral-500 block mb-0.5 font-bold"
            >
              // CAMPOS DE ACCIÓN
            </span>
            <span
              class="text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 font-bold"
            >
              Música, Psiquis & Código
            </span>
          </div>
        </div>

        <!-- Módulo de Interceptación de Audio (Música) -->
        <div
          class="p-3.5 rounded-xl border border-neutral-200/90 dark:border-neutral-800 bg-neutral-100/70 dark:bg-neutral-900/60 flex items-center justify-between gap-4"
        >
          <div class="flex items-center gap-3">
            <!-- Ecualizador de Barras Animado -->
            <div
              class="flex items-end gap-[3px] h-5 w-5 p-1 rounded bg-neutral-200/90 dark:bg-neutral-800"
            >
              <div
                class="w-1 bg-red-500 animate-[music-bar_0.8s_ease-in-out_infinite]"
              >
              </div>
              <div
                class="w-1 bg-neutral-800 dark:bg-neutral-200 animate-[music-bar_1.2s_ease-in-out_infinite_0.2s]"
              >
              </div>
              <div
                class="w-1 bg-red-500 animate-[music-bar_1s_ease-in-out_infinite_0.4s]"
              >
              </div>
            </div>

            <div class="flex flex-col">
              <span
                class="text-[9px] font-mono uppercase tracking-[0.2em] text-neutral-400 dark:text-neutral-500"
              >
                INTERCEPTED AUDIO FEED
              </span>
              <div class="flex items-baseline gap-2">
                <span
                  class="text-xs sm:text-sm font-bold tracking-tight text-neutral-900 dark:text-neutral-100 uppercase"
                >
                  $uicideboy$
                </span>
                <span class="text-neutral-400 dark:text-neutral-600 text-xs">·</span>
                <span
                  class="text-xs font-mono text-neutral-600 dark:text-neutral-400 uppercase"
                >
                  Monochromatic
                </span>
              </div>
            </div>
          </div>

          <div
            class="hidden sm:flex items-center gap-1 font-mono text-[9px] text-neutral-400 dark:text-neutral-500 border border-neutral-300 dark:border-neutral-800 rounded px-2 py-0.5 select-none"
          >
            <span>LO-FI</span>
            <span>//</span>
            <span>STEREO</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes music-bar {
    0%,
    100% {
      height: 20%;
    }
    50% {
      height: 100%;
    }
  }
</style>
