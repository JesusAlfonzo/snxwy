---
import LightLogo from "@assets/logos/LightLogo.svg";
import DarkLogo from "@assets/logos/DarkLogo.svg";
---

<footer class="w-full max-w-5xl mx-auto px-6 pt-6 pb-12 text-center select-none">
  <div class="flex justify-center pb-4">
    <img
      src={LightLogo.src}
      alt="Logo Snowy"
      width="40"
      height="40"
      class="block dark:hidden transition-opacity"
    />
    <img
      src={DarkLogo.src}
      alt="Logo Snowy"
      width="40"
      height="40"
      class="hidden dark:block transition-opacity"
    />
  </div>
  <span class="text-[9px] uppercase tracking-[0.4em] text-neutral-400 dark:text-neutral-500 font-mono">
    Exploración de la Psiquis — 2026
  </span>
</footer>
